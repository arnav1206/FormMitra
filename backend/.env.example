# Server Configuration
PORT=5000
NODE_ENV=development

# Wispr Flow AI Voice Recognition Engine
# Obtain your API Key from Wispr Flow partner portal (https://flow.wispr.ai)
WISPR_FLOW_API_KEY=
WISPR_FLOW_API_URL=https://api.wisprflow.ai/api

# AI Fallback Engine Providers (Optional)
GROQ_API_KEY=
OPENAI_API_KEY=

# Google Gemini AI (Form Extraction & Validation)
GEMINI_API_KEY=

# MongoDB Connection (Falls back to in-memory store if omitted)
MONGODB_URI=mongodb://localhost:27017/formmitra

# Security
JWT_SECRET=formmitra_secret_jwt_key_2025
